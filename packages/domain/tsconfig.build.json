{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "paths": {
      "@zanafleet/contracts": [
        "../contracts/dist"
      ],
      "@zanafleet/contracts/*": [
        "../contracts/dist/*"
      ],
      "@zanafleet/utils": [
        "../utils/dist"
      ],
      "@zanafleet/utils/*": [
        "../utils/dist/*"
      ],
      "@zanafleet/domain": [
        "./dist"
      ],
      "@zanafleet/domain/*": [
        "./dist/*"
      ],
      "@api/*": [
        "../../apps/api/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}